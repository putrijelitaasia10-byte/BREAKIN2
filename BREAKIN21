	local function selectTab(name)
		if CurrentTab == name then return end
		for n, data in pairs(TabButtons) do
			if n == name then
				TweenService:Create(data.button, TweenInfo.new(0.25), {BackgroundTransparency = 0.2, BackgroundColor3 = Theme.Panel2}):Play()
				TweenService:Create(data.label, TweenInfo.new(0.25), {TextColor3 = Theme.Text}):Play()
				TweenService:Create(data.indicator, TweenInfo.new(0.25), {Size = UDim2.new(0, 3, 0, 18)}):Play()
			else
				TweenService:Create(data.button, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
				TweenService:Create(data.label, TweenInfo.new(0.25), {TextColor3 = Theme.SubText}):Play()
				TweenService:Create(data.indicator, TweenInfo.new(0.25), {Size = UDim2.new(0, 3, 0, 0)}):Play()
			end
		end
		CurrentTab = name
		ContentTitle.Text = string.upper(name)

		-- Switch visible page
		for n, page in pairs(Tabs) do
			page.Visible = (n == name)
		end
	end

